# Copy this file to .env, or edit the existing .env beside this file.
# Paste the jobs endpoint URL after the equals sign.
JOBS_API_URL=
# Optional key. Never put an API key in frontend code or share this file.
JOBS_API_KEY=
# Default authentication is: Authorization: Bearer YOUR_KEY
# For X-API-Key authentication set the header to X-API-Key and prefix to NONE.
JOBS_API_KEY_HEADER=Authorization
JOBS_API_KEY_PREFIX=Bearer
# Optional override of the prepared Kaggle CSV:
JOBS_CSV=
# One separate JSearch query per supported career field.
JOBS_API_SEARCH_MODE=fields

# Optional O*NET Web Services v2 fallback; local derived database remains primary.
ONET_API_KEY=

# Public policy identity: supply verified operator details before launch.
SITE_OPERATOR_NAME=
SITE_PRIVACY_EMAIL=
